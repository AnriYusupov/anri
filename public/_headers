# медиа не меняется — можно кэшировать надолго
/media/*
  Cache-Control: public, max-age=31536000, immutable

# код и данные должны обновляться сразу, иначе правки не доходят до людей
/js/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/admin.html
  Cache-Control: no-cache
/speed.html
  Cache-Control: no-cache

# Библиотека 3D и данные фигуры не меняются от правки к правке, а весят много.
# Пусть лежат в кэше браузера: при замене к адресу дописывается новая версия
# (?v=N в index.html), и старый файл перестаёт использоваться.
# Правила ниже перекрывают общие, что заданы выше.
/js/three.min.js
  Cache-Control: public, max-age=31536000, immutable
/js/hls.min.js
  Cache-Control: public, max-age=31536000, immutable
/data/scene.txt
  Cache-Control: public, max-age=31536000, immutable
